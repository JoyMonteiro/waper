# Quarto build output. `docs/api/` is generated by `quartodoc build` from the
# package itself, so it is regenerated on every docs build and must not be
# committed; `docs/_site/` is the rendered site and `docs/objects.json` the
# quartodoc inventory. `docs/.quarto/` is also covered by `docs/.gitignore`,
# which Quarto writes itself and which is committed so it stops reappearing as
# an untracked file after every render.
docs/_site/
docs/api/
docs/.quarto/
docs/objects.json

dist/
build/
htmlcov/

.tox/
.ruff_cache/
.mypy_cache/
node_modules

dependency-graphs/
datasets/figures/
test-results/
uml-diagrams/
pydoer-graphs/
.venv/

# ---------------------------------------------------------------------------
# Data files. These are large (validation.nc alone is 3.9 GB) and must never be
# committed. The small fixtures below were already tracked before this rule
# existed and are un-ignored so they stay visible as the canonical test data;
# do not add new .nc files to that list without a good reason.
*.nc
!datasets/event_winds_abs_1.nc
!datasets/event_winds_abs_2.nc
!datasets/forecast_bust.nc
!datasets/souders_v_1.nc
!datasets/souders_v_2.nc
!datasets/v_winds_300mb_nh_2022_2023.nc
*.grib
*.h5
*.hdf5
*.zarr/

# Reference papers. Two were already tracked; the rest stay local.
*.pdf
!references/An_algorithm_for_Identification_and_Tracking_of_Rossby_Wave_Packets.pdf
!"references/Pandey et al. - 2020 - An Integrated Geometric and Topological Approach for the Identification and Visual Analysis of Rossb.pdf"

